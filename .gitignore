# ============================================================
# Smart Fire Detection v2
# ============================================================


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

venv/
.venv/
env/
ENV/

build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/


# ============================================================
# Environment / Secrets
# ============================================================
#
# ห้าม Commit Environment จริง
# ============================================================

.env
.env.*

# อนุญาตเฉพาะ Template
!.env.example


# Production Environment
production.env
deploy/production.env

# Local secret variants
*.secret.env
*.local.env


# Secret files
secrets/

*.key
*.pem
*.crt
*.p12
*.pfx


# ============================================================
# AI Models
# ============================================================
#
# Model binaries อาจมีขนาดใหญ่
# และไม่ควร Commit โดยไม่ตั้งใจ
# ============================================================

models/*

# Keep folder
!models/.gitkeep

# Documentation ภายใน models/
!models/README.md


# ============================================================
# Calibration
# ============================================================
#
# Calibration อาจเฉพาะ:
#
# - Camera
# - Lens
# - Zoom
# - Site
# - Position
#
# จึงไม่ควร Commit Calibration จริง
# ============================================================

calibration/*

# Keep folder
!calibration/.gitkeep

# Example calibration files สามารถ Commit ได้
!calibration/*.example.json


# ============================================================
# Runtime Generated Files
# ============================================================
#
# ใช้ static/* แทน static/
#
# เพื่อให้สามารถ Re-include .gitkeep ได้
# ============================================================

static/*


# Keep static directory
!static/.gitkeep


# ============================================================
# Alert spool
# ============================================================

!static/alert_spool/

static/alert_spool/*

!static/alert_spool/.gitkeep


# ============================================================
# Dataset / Training
# ============================================================

negative_datasets/

datasets/hard_negative_addon_*/

runs/
runs/detect/
runs/train/


# ============================================================
# Benchmark
# ============================================================
#
# ปกติถูก ignore อยู่แล้วจาก static/*
# เพิ่มไว้เป็น Documentation
# ============================================================

static/benchmark_runs/


# ============================================================
# Detection / Sweep outputs
# ============================================================

static/detection_runs/
static/sweep_runs/
static/stability_runs/
static/hard_negative_runs/


