# ============================================================
# Smart Fire Detection v2 - .gitignore
# ============================================================


# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# Virtual environments
venv/
.venv/
env/
ENV/

# Python build / package
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/


# ============================================================
# Environment / Secrets
# ============================================================

.env
.env.*
!.env.example

secrets/
*.key
*.pem


# ============================================================
# AI Models / Exported Models
# ============================================================

models/*.pt
models/*.pth
models/*.onnx
models/*.engine
models/*.torchscript

# OpenVINO
models/*_openvino_model/
models/*.xml
models/*.bin

# Keep models folder
!models/.gitkeep


# ============================================================
# Calibration
# ============================================================

# Site-specific calibration
calibration/*.json

# Calibration captures / verification images
calibration/captures/
calibration/verification/
calibration/bearing_verification/

# Keep calibration folder
!calibration/.gitkeep


# ============================================================
# Runtime / Generated Static Files
# ============================================================

# Direct files under static
static/*.jpg
static/*.jpeg
static/*.png
static/*.json
static/*.tmp

# Detection test results
static/detection_runs/

# Full sweep test results
static/sweep_runs/

# Hard-negative candidate collection
# สำคัญ: เก็บไว้ local แต่ไม่ commit เข้า Git
static/hard_negative_runs/

# Stability test results
static/stability_runs/

# Camera / PTZ test images
static/camera_test.jpg
static/sync_preset_*.jpg
static/detection_test_*.jpg

# Keep static folder
!static/.gitkeep


# ============================================================
# Dataset / Training Feedback
# ============================================================

# Negative datasets ที่ export ออกมาจากระบบ
# ไม่ควร push image dataset จำนวนมากเข้า Git ปกติ
negative_datasets/

# Generated dataset workspace
datasets/hard_negative_addon_*/

# Training outputs (Ultralytics)
runs/
runs/detect/
runs/train/


# ============================================================
# Logs / Temporary Files
# ============================================================

*.log
logs/

tmp/
temp/

*.tmp
*.bak
*.swp
*.swo


# ============================================================
# Testing / Coverage
# ============================================================

.pytest_cache/
.coverage
coverage.xml
htmlcov/


# ============================================================
# IDE / Editor
# ============================================================

.vscode/
.idea/
*.code-workspace


# ============================================================
# Windows
# ============================================================

Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/


# ============================================================
# macOS
# ============================================================

.DS_Store
.AppleDouble
.LSOverride


# ============================================================
# Linux
# ============================================================

*~
.directory


# ============================================================
# Archives
# ============================================================

*.zip
*.rar
*.7z