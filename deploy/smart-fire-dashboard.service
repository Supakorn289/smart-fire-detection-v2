[Unit]
Description=Smart Fire Detection v2 Dashboard

Wants=network-online.target
After=network-online.target
After=smart-fire-detection.service


[Service]
Type=simple


# ============================================================
# Runtime User
# ============================================================

User=smartfire
Group=smartfire


# ============================================================
# Project Directory
# ============================================================

WorkingDirectory=/opt/smart-fire-detection-v2


# ============================================================
# Production Environment
# ============================================================

EnvironmentFile=/etc/smart-fire-detection/production.env

Environment=PYTHONUNBUFFERED=1


# ============================================================
# Production WSGI Server
# ============================================================
#
# Development:
#
#   python app.py
#
# Production:
#
#   systemd
#       ↓
#   waitress-serve
#       ↓
#   app:app
#
# app.py ต้องมี Flask application object:
#
#   app = Flask(...)
#
# อยู่ที่ Module level
#
# ============================================================

ExecStart=/opt/smart-fire-detection-v2/venv/bin/waitress-serve --host=0.0.0.0 --port=5000 app:app


# ============================================================
# Restart Policy
# ============================================================

Restart=on-failure

RestartSec=5


# ============================================================
# Shutdown
# ============================================================

TimeoutStopSec=10


# ============================================================
# Basic Service Hardening
# ============================================================

NoNewPrivileges=true

PrivateTmp=true


[Install]
WantedBy=multi-user.target