[Unit]
Description=Smart Fire Detection v2 Dashboard
Documentation=Smart Fire Detection v2 Web Dashboard

Wants=network-online.target
After=network-online.target

# Dashboard อ่าน Runtime output ที่ main.py สร้าง
# แต่ไม่บังคับว่า Detection Service
# ต้อง Online ตลอดเวลา
After=smart-fire-detection.service


[Service]
Type=simple


# ============================================================
# Runtime User
# ============================================================

User=smartfire
Group=smartfire


# ============================================================
# Project Directory
# ============================================================

WorkingDirectory=/opt/smart-fire-detection-v2


# ============================================================
# Production Configuration
# ============================================================

EnvironmentFile=/etc/smart-fire-detection/production.env

Environment=PYTHONUNBUFFERED=1


# ============================================================
# Production WSGI Server
# ============================================================
#
# Development:
#
#   python app.py
#
# Production:
#
#   Waitress -> app:app
#
# app.py มี Flask application object ชื่อ:
#
#   app
#
# ============================================================

ExecStart=/opt/smart-fire-detection-v2/venv/bin/waitress-serve --host=0.0.0.0 --port=5000 app:app


# ============================================================
# Restart Policy
# ============================================================

Restart=on-failure
RestartSec=5


# ============================================================
# Shutdown
# ============================================================

TimeoutStopSec=10


# ============================================================
# Basic Security
# ============================================================

NoNewPrivileges=true
PrivateTmp=true


[Install]
WantedBy=multi-user.target