# ============================================================
# Smart Fire Detection v2
# Production Environment Template
# Final AI Model: R3-E6 Release V1
# ============================================================
#
# TEMPLATE ONLY
#
# ไฟล์นี้สามารถ Commit เข้า Git ได้
# เพราะต้องไม่มี:
#
# - Camera password จริง
# - Telegram token จริง
# - Telegram chat ID จริง
# - Site GPS จริง
#
# Installer จะใช้ Template นี้สร้าง:
#
# /etc/smart-fire-detection/production.env
#
# Production values จริงให้แก้เฉพาะไฟล์บน Server
#
# IMPORTANT:
#
# config.py ไม่ได้โหลด .env อัตโนมัติ
# Production Runtime ต้องรับค่าจาก systemd EnvironmentFile
# หรือ Environment ของ Process
#
# ============================================================


# ============================================================
# CAMERA / PTZ
# ============================================================

CAMERA_IP=CHANGE_ME

CAMERA_PORT=81

CAMERA_USER=CHANGE_ME

CAMERA_PWD=CHANGE_ME


# ============================================================
# RTSP
# ============================================================

RTSP_PORT=10554

RTSP_PATH=/tcp/av0_0


# ============================================================
# OPTIONAL CUSTOM RTSP URL
# ============================================================
#
# ปล่อยว่างตามปกติ
#
# เมื่อ CAMERA_ID ว่าง:
#
# config.py จะประกอบ RTSP URL จาก:
#
# CAMERA_USER
# CAMERA_PWD
# CAMERA_IP
# RTSP_PORT
# RTSP_PATH
#
# กำหนด CAMERA_ID เองเฉพาะกรณี
# Camera ต้องใช้ RTSP URL รูปแบบพิเศษ
#
# ห้ามใส่ RTSP URL ที่มี Credential จริง
# ลงใน Template ที่ Commit เข้า Git
#
# ============================================================

CAMERA_ID=


# ============================================================
# CAMERA FRAME
# ============================================================
#
# Resolution นี้ต้องตรงกับ:
#
# - RTSP Stream ที่ใช้งานจริง
# - Camera Intrinsics
# - Bearing Calibration
# - Distance Calibration
#
# ============================================================

FRAME_WIDTH=1280

FRAME_HEIGHT=720


# ============================================================
# CAMERA HORIZONTAL FOV
# ============================================================
#
# ต้องตรงกับ:
#
# Camera
# Lens
# Optical Zoom
# Digital Crop
# Resolution
#
# ที่ผ่าน Intrinsics Calibration
#
# หากมีการเปลี่ยน:
#
# - Lens
# - Optical zoom
# - Digital crop
# - Stream resolution
#
# ต้องตรวจ Camera Geometry / Calibration ใหม่
#
# ============================================================

HFOV_DEG=60.195288


# ============================================================
# PTZ TIMING
# ============================================================

DEG_PER_SEC=15.0

PTZ_BUFFER_SEC=1.5

INITIAL_PRESET_WAIT_SEC=5.0


# ============================================================
# POST-MOVE FRAME STABILITY
# ============================================================
#
# Runtime sequence:
#
# PTZ Move
#    ↓
# Wait
#    ↓
# Fresh Frames
#    ↓
# Stable-frame Verification
#    ↓
# AI Inference
#
# ============================================================

STABLE_DIFF_THRESHOLD=3.0

STABLE_REQUIRED_PAIRS=3

STABLE_TIMEOUT_SEC=5.0

POST_MOVE_FRESH_FRAMES=3


# ============================================================
# FINAL AI MODEL R3-E6
# ============================================================
#
# Final Model Runtime Artifact:
#
#   models/fire.pt
#
# Source Final Artifact:
#
#   fire_smoke_r3_e6_final.pt
#
# Production copy models/fire.pt ต้องเป็น Byte-for-byte
# copy ของ Final Artifact เท่านั้น
#
# Expected SHA256:
#
# 49dc0464d99a6c250cf3c3e305d4149c3d4ce3ee354d9d7a5ae1cb8c53a22183
#
# Class Contract:
#
#   0 = fire
#   1 = smoke
#
# ห้าม:
#
# - Train
# - Fine-tune
# - Quantize
# - Save checkpoint ใหม่แทน Final PT
# - เปลี่ยน Class order
#
# ============================================================


# ============================================================
# AI BACKEND — RELEASE V1
# ============================================================
#
# APPROVED Production Runtime:
#
#   MODEL_BACKEND=pt
#   INFERENCE_DEVICE=cpu
#
# OpenVINO FP32:
#
#   NOT APPROVED for Production Release V1
#
# ต้องผ่าน PT <-> OpenVINO Equivalence Gate
# ก่อนจึงจะพิจารณาใช้ Production ได้
#
# INT8:
#
#   NOT APPROVED
#
# ห้ามเปลี่ยน MODEL_BACKEND=openvino
# เพียงเพราะ Benchmark แสดงว่าเร็วกว่า
#
# Performance Benchmark != Backend Equivalence
#
# ============================================================

MODEL_BACKEND=pt

MODEL_PATH_PT=models/fire.pt

INFERENCE_DEVICE=cpu


# ============================================================
# OPTIONAL / EXPERIMENTAL OPENVINO ARTIFACT PATH
# ============================================================
#
# เก็บ Path ไว้สำหรับเครื่องมือ Export / Benchmark
# และ Equivalence Test ในอนาคตเท่านั้น
#
# Release V1 Production Runtime ห้ามเลือก Backend นี้
#
# ============================================================

MODEL_PATH_OPENVINO=models/fire_openvino_model


# ============================================================
# FINAL MODEL INFERENCE CONTRACT
# ============================================================
#
# Final R3-E6:
#
# IMGSZ        = 768
# Candidate    = 0.25
# NMS IoU      = 0.70
# max_det      = 300
# rect         = False
# batch        = 1
# device       = CPU
#
# IMPORTANT:
#
# Runtime ใช้ original OpenCV BGR frame
# ส่งตรงเข้า YOLO.predict()
#
# ห้าม preprocess Model Input เองก่อน YOLO.predict():
#
# - ห้าม resize เป็น 768x768 เอง
# - ห้าม manual letterbox
# - ห้าม BGR -> RGB เอง
# - ห้าม normalize /255 เอง
# - ห้าม tensor conversion เอง
#
# MODEL_RECT:
#
#   0 = False
#   1 = True
#
# Final R3-E6 ต้องเป็น 0
#
# ============================================================

IMGSZ=768

MODEL_NMS_IOU=0.70

MODEL_MAX_DET=300

MODEL_RECT=0

MODEL_BATCH=1


# ============================================================
# AI CANDIDATE DETECTION THRESHOLDS
# ============================================================
#
# Final R3-E6 Candidate Threshold:
#
#   fire  = 0.25
#   smoke = 0.25
#
# IMPORTANT:
#
# 0.25 คือ Candidate Detection Threshold
# ไม่ใช่ Final Alert Threshold
#
# Runtime flow:
#
# Candidate Detection
#        ↓
# Multi-frame Consensus
#        ↓
# Confirmed Detection
#        ↓
# Alert Deduplication
#        ↓
# Notification
#
# ห้ามเพิ่ม Threshold เพื่อแก้ False Positive
# โดยไม่มี Validation Data ที่เหมาะสม
#
# ============================================================

FIRE_THRESHOLD=0.25

SMOKE_THRESHOLD=0.25


# ============================================================
# MULTI-FRAME DETECTION
# ============================================================
#
# Final Integration Contract:
#
# ตรวจ 3 Frames ต่อ Scan
# ยืนยันอย่างน้อย 2 Frames
#
# KEEP:
#
# FRAMES_PER_SCAN=3
# MIN_CONFIRM_FRAMES=2
# FRAME_SAMPLE_GAP_SEC=0.15
#
# ============================================================

FRAMES_PER_SCAN=3

MIN_CONFIRM_FRAMES=2

FRAME_SAMPLE_GAP_SEC=0.15


# ============================================================
# MULTI-FRAME CONSENSUS
# ============================================================
#
# Spatial IoU สำหรับ Match Detection
# ของ Object เดียวกันระหว่างหลาย Frame
#
# Final Integration Contract:
#
# CONSENSUS_IOU_THRESHOLD=0.30
#
# Consensus ใช้ยืนยัน Detection
#
# Alert Deduplication เป็นอีกขั้นตอนหนึ่ง
# และไม่ควรใช้แทน Consensus
#
# ============================================================

CONSENSUS_IOU_THRESHOLD=0.30


# ============================================================
# AI STARTUP WARM-UP
# ============================================================
#
# Final Runtime Contract:
#
# STARTUP_WARMUP_RUNS=3
#
# Warm-up ทำครั้งเดียวก่อนเริ่ม Sweep
#
# Benchmark บน Final PT แสดงให้เห็นว่า
# First inference สามารถช้ากว่ารอบปกติมาก
# ดังนั้นต้องคง Startup Warm-up
#
# ============================================================

STARTUP_WARMUP_RUNS=3


# ============================================================
# CALIBRATION
# ============================================================

CALIBRATION_DIR=calibration


# ============================================================
# DISTANCE SAFETY RANGE
# ============================================================
#
# เป็น Runtime safety range
#
# ไม่ได้หมายความว่า Distance Calibration
# ถูก Validate ครบทั้งช่วงนี้
#
# GPS จะต้องอาศัย Calibration / Quality Gate
# ของระบบเพิ่มเติม
#
# ============================================================

MIN_VALID_DISTANCE_M=1.0

MAX_VALID_DISTANCE_M=200.0


# ============================================================
# CAMERA SITE LOCATION
# ============================================================
#
# nan หมายถึง:
#
# Site GPS ยังไม่ได้ตั้ง
#
# ใช้ nan ได้ในช่วง:
#
# - Development
# - Installation
# - Offline Preflight
# - Benchmark
# - Camera Test
# - PTZ Test
#
# ก่อน Production Ready:
#
# CAMERA_LAT / CAMERA_LON
# ต้องถูกเปลี่ยนเป็น Coordinate จริงของ Site
#
# ห้าม Commit Coordinate จริงเข้า Repository
#
# ============================================================

CAMERA_LAT=nan

CAMERA_LON=nan


# ============================================================
# TELEGRAM
# ============================================================
#
# Template ต้องไม่มี Credential จริง
#
# Production Server ให้กำหนด:
#
# TELEGRAM_TOKEN=<real token>
# TELEGRAM_CHAT_ID=<real chat id>
#
# ห้าม Commit Token / Chat ID จริง
# เข้า Repository
#
# Final Production Preflight ต้องตรวจ
# Notification configuration ก่อนประกาศ READY
#
# ============================================================

TELEGRAM_TOKEN=

TELEGRAM_CHAT_ID=


# ============================================================
# ALERT EVENT DEDUPLICATION
# ============================================================
#
# ขั้นตอนนี้เกิดหลัง Confirmed Detection
#
# Event เดิมจะถูก Suppress เมื่อ:
#
# - ยังอยู่ใน Cooldown
# - Bounding Box ใกล้เคียง Event ก่อนหน้า
#
# IMPORTANT:
#
# Alert Deduplication ไม่ใช่
# False Positive Detection Filter
#
# ============================================================

ALERT_COOLDOWN_SEC=30

ALERT_DEDUP_IOU_THRESHOLD=0.50


# ============================================================
# RUNTIME OUTPUT
# ============================================================

STATIC_DIR=static

DASHBOARD_WRITE_INTERVAL_SEC=1.0


# ============================================================
# SERVER MODE
# ============================================================
#
# Production Debian Server:
#
# HEADLESS_MODE=1
#
# 1 = Headless / Production
# 0 = GUI-capable Development
#
# ============================================================

HEADLESS_MODE=1