# ============================================================
# Smart Fire Detection v2
# Production Environment Template
# ============================================================
#
# TEMPLATE ONLY
#
# ไฟล์นี้สามารถอยู่ใน Git ได้
# เพราะต้องไม่มี Password / Token / Site GPS จริง
#
# Installer จะใช้ Template นี้สร้าง:
#
# /etc/smart-fire-detection/production.env
#
# Production values จริงให้แก้เฉพาะไฟล์บน Server
#
# ============================================================


# ============================================================
# CAMERA / PTZ
# ============================================================

CAMERA_IP=CHANGE_ME

CAMERA_PORT=81

CAMERA_USER=CHANGE_ME

CAMERA_PWD=CHANGE_ME


# ============================================================
# RTSP
# ============================================================

RTSP_PORT=10554

RTSP_PATH=/tcp/av0_0


# ============================================================
# OPTIONAL CUSTOM RTSP URL
# ============================================================
#
# ปล่อยว่างตามปกติ
#
# เมื่อ CAMERA_ID ว่าง:
#
# config.py จะประกอบ RTSP URL จาก:
#
# CAMERA_USER
# CAMERA_PWD
# CAMERA_IP
# RTSP_PORT
# RTSP_PATH
#
# กำหนด CAMERA_ID เองเฉพาะกรณี
# Camera ต้องใช้ RTSP URL รูปแบบพิเศษ
#
# ห้ามใส่ RTSP URL ที่มี Credential จริง
# ลงใน Template ที่ Commit เข้า Git
#
# ============================================================

CAMERA_ID=


# ============================================================
# CAMERA FRAME
# ============================================================

FRAME_WIDTH=1280

FRAME_HEIGHT=720


# ============================================================
# CAMERA HORIZONTAL FOV
# ============================================================
#
# ต้องตรงกับ:
#
# Camera
# Lens
# Optical Zoom
# Digital Crop
# Resolution
#
# ที่ผ่าน Intrinsics Calibration
#
# หาก Camera geometry เปลี่ยน
# ต้องตรวจหรือทำ Calibration ใหม่
#
# ============================================================

HFOV_DEG=60.195288


# ============================================================
# PTZ TIMING
# ============================================================

DEG_PER_SEC=15.0

PTZ_BUFFER_SEC=1.5

INITIAL_PRESET_WAIT_SEC=5.0


# ============================================================
# POST-MOVE FRAME STABILITY
# ============================================================
#
# หลัง PTZ Move:
#
# wait
#   ↓
# fresh frames
#   ↓
# stable-frame verification
#   ↓
# AI
#
# ============================================================

STABLE_DIFF_THRESHOLD=3.0

STABLE_REQUIRED_PAIRS=3

STABLE_TIMEOUT_SEC=5.0

POST_MOVE_FRESH_FRAMES=3


# ============================================================
# AI BACKEND
# ============================================================
#
# Initial Production Commissioning:
#
# MODEL_BACKEND=pt
# INFERENCE_DEVICE=cpu
#
# หลัง Benchmark บน Production Hardware
# สามารถเปลี่ยนเป็น:
#
# MODEL_BACKEND=openvino
# INFERENCE_DEVICE=intel:cpu
#
# ============================================================

MODEL_BACKEND=pt

MODEL_PATH_PT=models/fire.pt

MODEL_PATH_OPENVINO=models/fire_openvino_model

INFERENCE_DEVICE=cpu

IMGSZ=640


# ============================================================
# AI DETECTION THRESHOLDS
# ============================================================

FIRE_THRESHOLD=0.50

SMOKE_THRESHOLD=0.60


# ============================================================
# MULTI-FRAME DETECTION
# ============================================================
#
# Default:
#
# ตรวจ 3 Frame ต่อ Scan
# ต้องยืนยันอย่างน้อย 2 Frame
#
# ============================================================

FRAMES_PER_SCAN=3

MIN_CONFIRM_FRAMES=2

FRAME_SAMPLE_GAP_SEC=0.15


# ============================================================
# MULTI-FRAME CONSENSUS
# ============================================================
#
# IoU ขั้นต่ำสำหรับ Match Detection
# ของ Object เดียวกันระหว่างหลาย Frame
#
# Valid range:
#
# 0.0 - 1.0
#
# ============================================================

CONSENSUS_IOU_THRESHOLD=0.30


# ============================================================
# AI STARTUP WARM-UP
# ============================================================
#
# จำนวน Inference Warm-up
# ตอน Runtime เริ่มต้น
#
# Warm-up ทำครั้งเดียวก่อน Sweep
#
# ============================================================

STARTUP_WARMUP_RUNS=3


# ============================================================
# CALIBRATION
# ============================================================

CALIBRATION_DIR=calibration


# ============================================================
# DISTANCE SAFETY RANGE
# ============================================================

MIN_VALID_DISTANCE_M=1.0

MAX_VALID_DISTANCE_M=200.0


# ============================================================
# CAMERA SITE LOCATION
# ============================================================
#
# nan หมายถึง:
#
# Site GPS ยังไม่ได้ตั้ง
#
# ใช้ nan ได้ในช่วง:
#
# Installation
# Development
# Offline Preflight
# Benchmark
# Camera Test
# PTZ Test
#
# ก่อน Production Ready:
#
# CAMERA_LAT / CAMERA_LON
# ต้องถูกเปลี่ยนเป็น Coordinate จริงของ Site
#
# ห้าม Commit Coordinate จริงเข้า Repository
#
# ============================================================

CAMERA_LAT=nan

CAMERA_LON=nan


# ============================================================
# TELEGRAM
# ============================================================
#
# Optional
#
# หากไม่ใช้ Telegram:
#
# ปล่อยสองค่านี้ว่าง
#
# ห้ามใส่ Token / Chat ID จริง
# ใน Template ที่ Commit เข้า Git
#
# ============================================================

TELEGRAM_TOKEN=

TELEGRAM_CHAT_ID=


# ============================================================
# ALERT EVENT DEDUPLICATION
# ============================================================
#
# Event เดิมจะถูก Suppress
# เมื่อยังอยู่ใน Cooldown
# และ Bounding Box ใกล้เคียง Event ก่อนหน้า
#
# ============================================================

ALERT_COOLDOWN_SEC=30

ALERT_DEDUP_IOU_THRESHOLD=0.50


# ============================================================
# RUNTIME OUTPUT
# ============================================================

STATIC_DIR=static

DASHBOARD_WRITE_INTERVAL_SEC=1.0


# ============================================================
# SERVER MODE
# ============================================================
#
# 1 = Headless / Production
# 0 = GUI-capable Development
#
# ============================================================

HEADLESS_MODE=1