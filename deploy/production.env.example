# ============================================================
# Smart Fire Detection v2
# Production Environment Template
# ============================================================
#
# TEMPLATE ONLY
#
# ห้ามใส่ Password / Token / Site GPS จริง
# แล้ว Commit ไฟล์นี้ขึ้น Git
#
# Installer จะ Copy Template นี้ไปเป็น:
#
# /etc/smart-fire-detection/production.env
#
# Production values จริงให้แก้เฉพาะไฟล์บน Server
#
# ============================================================


# ============================================================
# CAMERA / RTSP
# ============================================================

CAMERA_IP=CHANGE_ME
CAMERA_PORT=81

CAMERA_USER=CHANGE_ME
CAMERA_PWD=CHANGE_ME

RTSP_PORT=10554
RTSP_PATH=/tcp/av0_0

# Optional:
#
# ถ้ากำหนด CAMERA_ID
# ระบบจะใช้ RTSP URL นี้โดยตรง
#
# ถ้าปล่อยว่าง
# config.py จะประกอบ RTSP URL จาก:
#
# CAMERA_USER
# CAMERA_PWD
# CAMERA_IP
# RTSP_PORT
# RTSP_PATH
#
CAMERA_ID=


# ============================================================
# CAMERA FRAME
# ============================================================

FRAME_WIDTH=1280
FRAME_HEIGHT=720


# ============================================================
# CAMERA FOV
# ============================================================
#
# ต้องตรงกับ Camera / Lens / Zoom / Crop / Resolution
# ที่ผ่าน Intrinsics Calibration
#
# หาก Camera geometry เปลี่ยน
# ต้องตรวจ Calibration ใหม่
#
# ============================================================

HFOV_DEG=60.195288


# ============================================================
# PTZ
# ============================================================

DEG_PER_SEC=15.0

PTZ_BUFFER_SEC=1.5

INITIAL_PRESET_WAIT_SEC=5.0

STABLE_DIFF_THRESHOLD=3.0

STABLE_REQUIRED_PAIRS=3

STABLE_TIMEOUT_SEC=5.0

POST_MOVE_FRESH_FRAMES=3


# ============================================================
# AI BACKEND
# ============================================================
#
# Production commissioning ครั้งแรก
# ให้เริ่ม Benchmark จาก PyTorch ก่อน
#
# หลัง Benchmark สามารถเปลี่ยนเป็น:
#
# MODEL_BACKEND=openvino
# INFERENCE_DEVICE=intel:cpu
#
# ============================================================

MODEL_BACKEND=pt

MODEL_PATH_PT=models/fire.pt

MODEL_PATH_OPENVINO=models/fire_openvino_model

INFERENCE_DEVICE=cpu

IMGSZ=640


# ============================================================
# AI DETECTION
# ============================================================

FIRE_THRESHOLD=0.50

SMOKE_THRESHOLD=0.60

FRAMES_PER_SCAN=3

MIN_CONFIRM_FRAMES=2

FRAME_SAMPLE_GAP_SEC=0.15


# ============================================================
# MULTI-FRAME CONSENSUS
# ============================================================
#
# IoU ขั้นต่ำสำหรับจับคู่ Detection
# ของ Object เดียวกันระหว่างหลาย Frame
#
# ============================================================

CONSENSUS_IOU_THRESHOLD=0.30


# ============================================================
# AI STARTUP
# ============================================================

STARTUP_WARMUP_RUNS=3


# ============================================================
# CALIBRATION
# ============================================================

CALIBRATION_DIR=calibration

MIN_VALID_DISTANCE_M=1.0

MAX_VALID_DISTANCE_M=200.0


# ============================================================
# SITE LOCATION
# ============================================================
#
# nan = ยังไม่ได้ตั้ง Site จริง
#
# ใช้ nan ได้ในช่วง:
#
# - Installation
# - Development
# - Offline validation
# - Hardware commissioning บางส่วน
#
# ก่อน Production Ready:
#
# ต้องเปลี่ยนเป็น Coordinate จริง
#
# ห้าม Commit Coordinate จริงขึ้น Git
#
# ============================================================

CAMERA_LAT=nan

CAMERA_LON=nan


# ============================================================
# TELEGRAM
# ============================================================
#
# Optional
#
# ปล่อยว่างได้หากไม่ใช้ Telegram
#
# ห้ามใส่ Token จริงใน Template นี้
#
# ============================================================

TELEGRAM_TOKEN=

TELEGRAM_CHAT_ID=


# ============================================================
# ALERT
# ============================================================

ALERT_COOLDOWN_SEC=30

ALERT_DEDUP_IOU_THRESHOLD=0.50


# ============================================================
# OUTPUT
# ============================================================

STATIC_DIR=static

DASHBOARD_WRITE_INTERVAL_SEC=1.0


# ============================================================
# SERVER MODE
# ============================================================

HEADLESS_MODE=1